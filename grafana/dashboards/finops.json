{
  "uid": "finops-live",
  "title": "Live FinOps PoC",
  "description": "Real-time Cloud FinOps dashboard powered by Apache Flink and PostgreSQL. Monitors live infrastructure metrics and automatically detects runaway spend anomalies.",
  "tags": [
    "finops",
    "flink"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Live Cloud Burn",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic",
            "seriesBy": "last"
          },
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisLabel": "cost per 10s window",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finops-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  window_end AS \"time\",\n  resource_id AS metric,\n  total_cost_usd\nFROM finops_cost\nWHERE $__timeFilter(window_end)\nORDER BY time ASC"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Anomalies Alert",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "finops-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-red"
          },
          "decimals": 2,
          "noValue": "$0.00",
          "unit": "currencyUSD",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "desc": true,
            "displayName": "time"
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "finops-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  window_end AS \"time\",\n  resource_id,\n  total_cost_usd\nFROM finops_cost\nWHERE is_anomaly = true\n  AND $__timeFilter(window_end)\nORDER BY time DESC\nLIMIT 10"
        }
      ]
    }
  ]
}